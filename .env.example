# ── Seguridad ─────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIAR-POR-CLAVE-SEGURA-openssl-rand-hex-32
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────
# Postgres del host (instancia compartida del VPS).
# host.docker.internal resuelve al host desde dentro del container Docker.
# Usar las mismas credenciales que ya tiene el Postgres del VPS.
DB_USER=siscont
DB_PASSWORD=CAMBIAR-PASSWORD-POSTGRES
DATABASE_URL=postgresql+psycopg://siscont:CAMBIAR-PASSWORD-POSTGRES@host.docker.internal:5432/qtienda

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=["https://qtienda.shop","https://www.qtienda.shop"]

# ── Storage (Cloudflare R2) ────────────────────────────────────
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=qtienda
CDN_URL=https://cdn.qtienda.shop

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=qtienda <ventas@qtienda.shop>
APP_URL=https://qtienda.shop

# ── Web Push (VAPID) ───────────────────────────────────────────
# Ruta del archivo dentro del container (se copia automáticamente con COPY . .)
VAPID_PRIVATE_KEY=/app/vapid_private.pem
VAPID_PUBLIC_KEY=BI3QpPUdp4cNR0eVBGVXZX_YIy5mwM4ktpJKEMEdu0daOCesGurVckCKkRddT915AHdKxVTF06AGXdoPDDWIJ0c
VAPID_CLAIMS_EMAIL=mailto:ventas@qtienda.shop

# ── Culqi (pagos con tarjeta) ──────────────────────────────────
CULQI_SECRET_KEY=sk_live_xxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# ── Planes ────────────────────────────────────────────────────
FREE_PLAN_SLUG=free
TRIAL_DAYS=14
